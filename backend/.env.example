# Configure credentials only in the host environment or secret store.
FDN_API_KEY=
FDN_LOOKBACK_DAYS=7
FDN_CACHE_SECONDS=300
FDN_TIMEOUT_SECONDS=8
FDN_MAX_PAGES_PER_DAY=6
FDN_MAX_REQUESTS_PER_MINUTE=30
FDN_MAX_REQUESTS_PER_DAY=300

# Existing IG DEMO execution settings retain their semantics.
CATEGORY_AUTOTRADE=true
CATEGORY_RISK_PER_TRADE_PCT=1.0
FOREX_MAX_DAILY_ENTRIES=4
FOREX_MAX_DAILY_ENTRIES_PER_PAIR=1
XAU_MAX_DAILY_ENTRIES=2
FOREX_NEWS_GUARD_REQUIRED=false
